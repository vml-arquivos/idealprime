# Ideal Prime — exemplo SEM segredos reais
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://ideal_prime:CHANGE_ME@postgres:5432/ideal_prime
DB_SSL=false
JWT_SECRET=CHANGE_ME_64_RANDOM_CHARS
SESSION_SECRET=CHANGE_ME_ANOTHER_64_RANDOM_CHARS
APP_URL=https://SEU-DOMINIO
VITE_STOREFRONT_URL=https://SEU-DOMINIO
VITE_PANEL_URL=https://SEU-DOMINIO
VITE_APP_TITLE=Ideal Prime
VITE_APP_ID=ideal-prime
DATA_DIR=/var/data/ideal-prime
UPLOAD_DIR=/var/data/ideal-prime/uploads
POSTGRES_PASSWORD=CHANGE_ME
# Integrações opcionais: preencher somente se forem efetivamente usadas.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
S3_ENDPOINT=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
LLM_MODEL_NAME=
