# Ideal Prime — exemplo SEM segredos reais
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://ideal_prime:CHANGE_ME@postgres:5432/ideal_prime
DB_SSL=false
JWT_SECRET=CHANGE_ME_64_RANDOM_CHARS
SESSION_SECRET=CHANGE_ME_ANOTHER_64_RANDOM_CHARS
APP_URL=https://SEU-DOMINIO
VITE_STOREFRONT_URL=https://SEU-DOMINIO
VITE_PANEL_URL=https://SEU-DOMINIO
VITE_APP_TITLE=Ideal Prime
VITE_APP_ID=ideal-prime
DATA_DIR=/var/data/ideal-prime
UPLOAD_DIR=/var/data/ideal-prime/uploads
POSTGRES_PASSWORD=CHANGE_ME
# Integrações opcionais: preencher somente se forem efetivamente usadas.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
S3_ENDPOINT=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
LLM_MODEL_NAME=
# Nota Fiscal Eletrônica (NF-e/NFC-e) — nenhum provedor real está integrado ainda.
# O provedor ativo é lido do banco (Configurações > Nota Fiscal), não daqui; estas
# variáveis existem só como referência para quando um provedor real for contratado —
# ver docs/ideal-prime/NFE_INTEGRACAO.md. Deixe em branco enquanto não configurado.
NFE_PROVIDER_API_KEY=
NFE_PROVIDER_API_URL=
NFE_CERTIFICADO_A1_PATH=
NFE_CERTIFICADO_A1_SENHA=

# Catálogo Mestre / carga inicial segura (opcional)
# false por padrão: habilite apenas no deploy de popularização controlada.
SEED_CATALOG_MASTER_ON_STARTUP=false
CATALOG_SEED_FILE=/app/data/seed/IDEAL_PRIME_CATALOGO_MASTER_SEED.xlsx
# SKIP = não altera estoque existente; SET_IF_EMPTY = só preenche saldo <= 0; FORCE = força, mas bloqueia se houver FIFO ativo/aguardando.
CATALOG_SEED_STOCK_MODE=SKIP
